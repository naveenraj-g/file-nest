# ── App ────────────────────────────────────────────────────────────────────────
LOG_DIR=../logs/iam
INTERNAL_URL=http://localhost:5000

# ── Better Auth ────────────────────────────────────────────────────────────────
# Generate: openssl rand -hex 32
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:5000

# ── OAuth page URLs ────────────────────────────────────────────────────────────
LOGIN_PAGE=http://localhost:5000/auth/sign-in
CONSENT_PAGE=http://localhost:5000/auth/consent
SIGNUP_PAGE=http://localhost:5000/auth/sign-up
TWO_FACTOR_PAGE=http://localhost:5000/auth/two-factor

# ── Database ───────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://iam_user:iam_password@localhost:5433/iam_db

# ── Social OAuth providers (optional — remove unused blocks) ───────────────────
# Register apps at: https://github.com/settings/developers
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Register apps at: https://console.cloud.google.com/
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── Email (SMTP) ───────────────────────────────────────────────────────────────
SMTP_EMAIL=
SMTP_PASS=
SMTP_FROM_NAME=FileNest

# ── Internal API ───────────────────────────────────────────────────────────────
# Shared secret between the IAM and the backend for internal API calls.
# Must match INTERNAL_API_SECRET in backend/.env.
# Generate: openssl rand -hex 32
INTERNAL_API_SECRET=

# ── Cloudflare Turnstile (bot protection — optional) ───────────────────────────
# Register at: https://dash.cloudflare.com/ → Turnstile
TURNSTILE_SECRET_KEY=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
