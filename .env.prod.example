# Root .env for docker-compose.prod.yml
# Copy to .env before running: cp .env.prod.example .env
# Do NOT commit this file with real values.

# ── Database passwords ────────────────────────────────────────────────────────
# Both databases live on the same PostgreSQL instance.
# POSTGRES_PASSWORD  → filenest database (backend)
# IAM_POSTGRES_PASSWORD → iam_db database (IAM)
# The init script (docker/postgres-init.sh) creates iam_db and iam_user on first start.
# Generate: openssl rand -hex 16
POSTGRES_PASSWORD=
IAM_POSTGRES_PASSWORD=

# ── RustFS credentials ────────────────────────────────────────────────────────
# Must match RUSTFS_ACCESS_KEY_ID / RUSTFS_SECRET_ACCESS_KEY in backend/.env.
RUSTFS_ACCESS_KEY_ID=
RUSTFS_SECRET_ACCESS_KEY=

# ── Console app build args (baked into the Next.js bundle at build time) ──────
# Set these to your production hostnames before building.
# If any of these change, you must rebuild the console image.
NEXT_PUBLIC_BETTER_AUTH_URL=https://auth.example.com
NEXT_PUBLIC_BETTER_AUTH_CLIENT_ID=filenest-console
NEXT_PUBLIC_APP_URL=https://console.example.com

# ── IAM build args ────────────────────────────────────────────────────────────
# Leave empty if not using Cloudflare Turnstile bot protection.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
